# Google Gemini Free-Tier API Key (From https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-3.6-flash (recommended) or gemini-3.7-flash
GEMINI_MODEL=gemini-3.6-flash

# Optional: Google OAuth Credentials for Live YouTube Sync (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
